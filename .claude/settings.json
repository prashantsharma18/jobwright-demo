{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/stories/**)",
      "Edit(/incidents/**)",
      "Edit(/feedback/**)",
      "Edit(/jobwright-app/.worktrees/**)",
      "Edit(/jobwright-gitops/.worktrees/**)",
      "Read(~/.claude/plugins/cache/aidlc/**)",
      "Read(~/.claude/plugins/marketplaces/aidlc/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete*)",
      "Bash(git push * main*)",
      "Bash(git push *:main*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        ".env",
        ".env.*",
        "~/.ssh",
        "~/.aws"
      ]
    }
  },
  "enabledPlugins": {
    "aidlc@aidlc": true
  }
}
